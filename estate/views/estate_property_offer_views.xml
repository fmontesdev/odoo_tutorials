<odoo>
  <data>
    <!-- Definimos como es la vista explicita de la lista-->
    <record  id="estate_property_offer_view_list" model="ir.ui.view">
      <field name="name">estate.property.offer.list</field>
      <field name="model">estate.property.offer</field>
      <field name="arch" type="xml">
        <!-- Lista editable y con decoraciones según el estado de la oferta -->
        <list string="Listado de Ofertas de Propiedades Inmobiliarias" editable="bottom"
            decoration-success="status == 'accepted'"
            decoration-danger="status == 'refused'">
          <field name="price"/>
          <field name="partner_id"/>
          <field name="validity"/>
          <field name="date_deadline"/>
          <!-- Botones para aceptar o rechazar la oferta se ocultan si el estado es 'accepted' o 'refused' -->
          <button name="action_accept" type="object" string="Aceptar" icon="fa-check"
            invisible="status in ('accepted', 'refused')"/>
          <button name="action_refuse" type="object" string="Rechazar" icon="fa-times"
            invisible="status in ('accepted', 'refused')"/>
          <field name="status" column_invisible="1"/>
        </list>
      </field>
    </record>

    <!-- Definimos como es la vista explicita del formulario-->
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
          <form string="Oferta de Propiedad Inmobiliaria">
            <sheet>
              <group>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status"/>
              </group>
            </sheet>
          </form>
        </field>
    </record>

  </data>
</odoo>
