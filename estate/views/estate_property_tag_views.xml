<odoo>
  <data>
    <!-- Definimos como es la vista explicita de búsqueda-->
    <record id="estate_property_tag_view_search" model="ir.ui.view">
        <field name="name">estate.property.tag.search</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <search string="Búsqueda de Etiquetas de Propiedades Inmobiliarias">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Definimos como es la vista explicita de la lista-->
    <record  id="estate_property_tag_view_list" model="ir.ui.view">
      <field name="name">estate.property.tag.list</field>
      <field name="model">estate.property.tag</field>
      <field name="arch" type="xml">
        <list string="Listado de Etiquetas de Propiedades Inmobiliarias">
          <field name="name" />
        </list>
      </field>
    </record>

    <!-- Definimos como es la vista explicita del formulario-->
    <record id="estate_property_tag_view_form" model="ir.ui.view">
        <field name="name">estate.property.tag.form</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
          <form string="Etiqueta de Propiedad Inmobiliaria">
            <sheet>
              <group>
                <field name="name"/>
              </group>
            </sheet>
          </form>
        </field>
    </record>

  </data>
</odoo>
