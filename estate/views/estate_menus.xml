<odoo>
  <data>
    <!-- Acción para las propiedades inmobiliarias -->
    <record id="estate_property_action" model="ir.actions.act_window">
      <!-- Nombre de la acción que aparecerá en el menú-->
      <field name="name">Propiedades Inmobiliarias</field>
      <!-- Nombre del modelo que mostraremos en la vista-->
      <field name="res_model">estate.property</field>
      <!-- Indicamos que nuestro formulario tendrá vista list (para mostrar todos los datos) y vista form (para crear o editar datos) -->
      <field name="view_mode">list,form</field>
      <!-- Contexto para que por defecto se muestren las propiedades disponibles -->
      <field name="context">{'search_default_available': True}</field>
    </record>

    <!-- Acción para los tipos de propiedades inmobiliarias-->
    <record id="estate_property_type_action" model="ir.actions.act_window">
      <field name="name">Tipos de Propiedades Inmobiliarias</field>
      <field name="res_model">estate.property.type</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Acción para las etiquetas de propiedades inmobiliarias-->
    <record id="estate_property_tag_action" model="ir.actions.act_window">
      <field name="name">Etiquetas de Propiedades Inmobiliarias</field>
      <field name="res_model">estate.property.tag</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Definimos los 3 niveles del menú para acceder a la acción definida -->
    <menuitem id="estate_property_menu_root" name="Inmobiliaria">
        <menuitem id="estate_property_first_level_menu" name="Anuncios">
            <menuitem id="estate_property_menu_action" action="estate_property_action"/>
        </menuitem>
        <menuitem id="estate_property_second_level_menu" name="Opciones">
            <menuitem id="estate_property_type_menu_action" action="estate_property_type_action"/>
            <menuitem id="estate_property_tag_menu_action" action="estate_property_tag_action"/>
        </menuitem>
    </menuitem>
  </data>
</odoo>