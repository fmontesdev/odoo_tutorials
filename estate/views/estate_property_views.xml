<odoo>
  <data>
    <!-- Definimos como es la vista explicita de búsqueda-->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Búsqueda de Propiedades Inmobiliarias">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <!-- Filtro para área habitable que sea mayor o igual a un valor dado -->
                <field name="living_area"
                  filter_domain="[('living_area', '>=', self)]"/>
                <field name="garden_area" />
                <field name="total_area" />

                <filter
                  string="Disponibles"
                  name="available"
                  domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"
                />
                <filter string="Archivados" name="inactives" domain="[('active', '=', False)]"/>

                <group>
                    <filter string="Código Postal" name="group_by_postcode" context="{'group_by':'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Definimos como es la vista explicita de la lista-->
    <record  id="estate_property_view_list" model="ir.ui.view">
      <field name="name">estate.property.list</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
        <!-- Lista con decoraciones según el estado de la propiedad -->
        <list string="Listado de Propiedades Inmobiliarias"
            decoration-success="state == 'offer_received' or state == 'offer_accepted'"
            decoration-bf="state == 'offer_accepted'"
            decoration-muted="state == 'sold'">
          <field name="name"/>
          <field name="property_type_id"/>
          <field name="postcode"/>
          <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
          <field name="bedrooms"/>
          <field name="living_area"/>
          <field name="expected_price"/>
          <field name="selling_price"/>
          <field name="date_availability" optional="hide"/>
          <field name="state" column_invisible="1"/>
        </list>
      </field>
    </record>

    <!-- Definimos como es la vista explicita del formulario-->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
          <form string="Propiedad Inmobiliaria">
            <!-- Botones de acción -->
            <header>
                <!-- El botón se oculta si el estado es 'sold' o 'canceled' -->
                <button name="action_set_sold" type="object" string="Vender"
                  invisible="state in ('sold', 'canceled')"/>
                <button name="action_set_canceled" type="object" string="Cancelar"
                  invisible="state in ('sold', 'canceled')"/>
                <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
            </header>

            <sheet>
              <!-- Título de la propiedad -->
              <h1>
                <field name="name"/>
              </h1>

              <!-- Etiquetas de la propiedad -->
              <group>
                <!-- color_field añade color a las etiquetas según el campo color definido en el modelo estate.property.tag -->
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" nolabel="1"/>
              </group>

              <!-- Grupo de campos en dos columnas -->
              <group>
                <group>
                  <!-- no_create y no_open para evitar crear, editar o abrir tipos de propiedad desde aquí -->
                  <field name="property_type_id" options="{'no_create': True, 'no_open': True}"/>
                  <field name="postcode"/>
                  <field name="date_availability"/>
                </group>
                <group>
                  <field name="expected_price"/>
                  <field name="best_price"/>
                  <field name="selling_price"/>
                </group>
              </group>

              <!-- Grupo de pestañas -->
              <notebook>
                <!-- Pestaña descripción -->
                <page string="Descripción">
                  <group>
                    <field name="description"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="facades"/>
                    <field name="garage"/>
                    <field name="garden"/>
                    <field name="garden_area" invisible="not garden"/>
                    <field name="garden_orientation" invisible="not garden"/>
                    <field name="total_area"/>
                  </group>
                </page>

                <!-- Pestaña ofertas -->
                <page string="Ofertas">
                  <!-- Lista de ofertas relacionadas con la propiedad, no editable si el estado es 'offer_accepted', 'sold' o 'canceled' -->
                  <field name="offer_ids" readonly="state in ('offer_accepted', 'sold', 'canceled')"/>
                </page>

                <!-- Pestaña otra información -->
                <page string="Otra información">
                  <group>
                    <field name="salesman_id"/>
                    <field name="buyer_id"/>
                  </group>
                </page>
              </notebook>

            </sheet>
          </form>
        </field>
    </record>

    <!-- Definimos como es la vista explicita de kanban-->
    <record  id="estate_property_view_kanban" model="ir.ui.view">
      <field name="name">estate.property.kanban</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
        <kanban string="Kanban de Propiedades Inmobiliarias"
            default_group_by="property_type_id" records_draggable="false">
          <!-- Declarar campos que se utilizan en expresiones -->
          <field name="state"/>

          <templates>
            <t t-name="card">
              <div class="oe_kanban_card">
                <div class="oe_kanban_content">
                  <div class="mb-1">
                    <strong><field name="name"/></strong>
                  </div>
                  <div>
                    <span>Precio esperado: </span>
                    <field name="expected_price"/>
                  </div>
                  <div t-if="record.state.raw_value == 'offer_received' or record.state.raw_value == 'offer_accepted'">
                    <span>Mejor oferta: </span>
                    <field name="best_price"/>
                  </div>
                  <div t-if="record.state.raw_value == 'offer_accepted' or record.state.raw_value == 'sold'">
                    <span>Precio de venta: </span>
                    <field name="selling_price"/>
                  </div>
                  <div class="mt-2">
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
  </data>
</odoo>
